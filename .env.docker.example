####
# Production environment for docker-compose.prod.yml
# Copy to .env, fill in every value below, and NEVER commit the result.
#   cp .env.docker.example .env
####

APP_NAME=Solar
APP_ENV=production
# Generate with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="UTC"
# Public hostname you will point at this app via Cloudflare Tunnel, e.g. https://solar.zilchy.link
APP_URL=

PERF_PROFILE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (SQLite) ---
# DB_CONNECTION/DB_DATABASE are pinned in docker-compose.prod.yml (bind-mounts
# your real database.sqlite from ./database/database.sqlite on the host into
# the container) — nothing to set here.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your real domain once known, e.g. solar.zilchy.link (no scheme)
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE is pinned to true in docker-compose.prod.yml

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# --- Cloudflare Tunnel ---
# No token needed here — the tunnel is authenticated via the classic
# `cloudflared tunnel login/create/route dns` CLI flow, with credentials
# stored in ./.cloudflared/ (gitignored). See docker/production/README.md.

# --- Solcast ---
SOLCAST_API_KEY=
SOLCAST_RESOURCE_ID=
SOLCAST_DAILY_CAP=6
SOLCAST_FORECAST_MIN_INTERVAL=PT4H
SOLCAST_ACTUAL_MIN_INTERVAL=PT8H
SOLCAST_429_BACKOFF=PT8H
SOLCAST_RESET_TZ=UTC

# --- Octopus Energy ---
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT=
OCTOPUS_EXPORT_MPAN=
OCTOPUS_IMPORT_MPAN=
OCTOPUS_EXPORT_SERIAL_NUMBER=
OCTOPUS_IMPORT_SERIAL_NUMBER=

# --- Solis ---
SOLIS_KEY_ID=
SOLIS_KEY_SECRET=
SOLIS_INVERTER_ID=
SOLIS_API_URL=https://www.soliscloud.com:13333

# Must match the uid/gid that owns the checked-out source on the host,
# so bind-mounted files (if you add any) stay writable. 1000 is fine on
# a fresh Linux host/user.
WWWGROUP=1000
WWWUSER=1000
